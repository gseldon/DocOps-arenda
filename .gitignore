# Игнорировать папку с документами
doc/

# Игнорировать файл с реальными персональными данными
contract_data.json

# Альтернативно, если нужно отслеживать структуру папок:
# doc/*.docx
# doc/*.pdf
# doc/summary/

# Игнорировать резервные копии
*_backup.py
*.bak

# Игнорировать временные файлы Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Не игнорировать папку example и файлы в ней
!example/
!example/**

# Игнорировать виртуальные окружения (если будут использоваться)
venv/
env/
ENV/
.venv/

# Игнорировать системные файлы
.DS_Store
Thumbs.db
*.swp
*.swo
*~


# Локальная оценка проекта (не отслеживается)
docs/ASSESSMENT.md
